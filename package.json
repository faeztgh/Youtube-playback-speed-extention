{
    "name": "yt-playback-controller",
    "version": "0.1.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently -n content,app -c blue,green \"cross-env BUILD_TARGET=content vite build --watch\" \"cross-env BUILD_TARGET=app vite build --watch\"",
        "build": "pnpm clean && pnpm build:app && pnpm build:content",
        "build:content": "cross-env BUILD_TARGET=content vite build",
        "build:app": "cross-env BUILD_TARGET=app vite build",
        "clean": "rimraf dist",
        "icons": "node scripts/generate-icons.js",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "prepare": "lefthook install || 0"
    },
    "dependencies": {
        "lucide-react": "^0.555.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.3.0",
        "@commitlint/cli": "^19.6.1",
        "@commitlint/config-conventional": "^19.6.0",
        "@tailwindcss/postcss": "^4.3.1",
        "@types/chrome": "^0.1.31",
        "@types/node": "24.10.1",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.1.9",
        "@vitejs/plugin-react": "^5.1.1",
        "autoprefixer": "^10.4.22",
        "concurrently": "^9.2.1",
        "cross-env": "^10.1.0",
        "lefthook": "^1.10.10",
        "postcss": "^8.5.18",
        "rimraf": "^6.1.2",
        "sharp": "^0.35.0",
        "tailwindcss": "^4.3.1",
        "typescript": "^5.9.3",
        "vite": "^7.3.5"
    },
    "engines": {
        "node": ">=18.0.0",
        "pnpm": ">=8.0.0"
    }
}
